# ==============================================================================
# NexusOps AI & VyaparShield — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application Core ---
APP_NAME="NexusOps AI"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Networking & Ports ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- PostgreSQL & pgvector Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=nexusops_secure_password
POSTGRES_DB=nexusops_db
# Async URL for FastAPI / SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://nexusops:nexusops_secure_password@localhost:5432/nexusops_db
# Sync URL for Alembic migrations and CLI scripts
DATABASE_SYNC_URL=postgresql+psycopg2://nexusops:nexusops_secure_password@localhost:5432/nexusops_db

# --- Redis & Background Task Queue (Celery) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object Storage (MinIO / S3) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=nexusops-documents
S3_REGION=ap-south-1

# --- LLM Providers & Embeddings ---
# Provider options: "gemini", "openai", "anthropic", "ollama"
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=text-embedding-004

# API Keys (Provide the one corresponding to LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# --- AgentGuard & AI Security Policy ---
AGENT_POLICY_DENY_BY_DEFAULT=True
ENABLE_HUMAN_APPROVAL_GATE=True
MAX_AUTONOMOUS_TOOL_BUDGET=5
REDACT_SENSITIVE_LOGS=True

# --- Observability, Metrics & Tracing ---
ENABLE_OPENTELEMETRY=False
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_ENABLED=True

# --- SMTP & Notification Service ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
EMAILS_FROM_EMAIL=notifications@nexusops.ai
EMAILS_FROM_NAME="NexusOps Finance Alerts"
